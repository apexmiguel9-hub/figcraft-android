<?xml version="1.0" encoding="utf-8"?>
<!-- Icono VoidXStudio: V y X entrelazadas, vector original, sin assets de terceros. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Fondo oscuro con esquinas redondeadas -->
    <path
        android:fillColor="#121212"
        android:pathData="M0,0h108v108h-108z" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#333333"
        android:strokeWidth="4"
        android:pathData="M12,12h84v84h-84z" />

    <!-- V y X entrelazadas: trazo en blanco con ligera profundidad -->
    <group
        android:translateX="20"
        android:translateY="22">

        <!-- V izquierda -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M0,60 L20,0 L40,60" />

        <!-- X derecha, entrelazada con la V -->
        <path
            android:fillColor="#E0E0E0"
            android:pathData="M56,60 L76,0 L96,60 M76,0 L76,60 M56,60 L96,0" />

        <!-- Connexion entrelazada en el centro -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M40,30 L60,30 M60,60 L40,60" />
    </group>

</vector>
